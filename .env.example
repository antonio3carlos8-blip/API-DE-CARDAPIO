# Porta do servidor backend (padrão: 3001)
PORT=3001
HOST=127.0.0.1

# Em produção use sempre postgres. O modo memory é exclusivo de npm run dev/test.
DATA_STORE="postgres"

# URL de conexão com o banco de dados PostgreSQL / Supabase
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# URL direta para migrações do Prisma (opcional, cai de volta para DATABASE_URL se não definida)
DIRECT_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# Ajuste conforme o limite do pooler do provedor (Vercel/Supabase costuma exigir baixo valor).
DATABASE_POOL_SIZE=3

# Origens permitidas pelo CORS (separadas por vírgula em produção)
CORS_ORIGIN="http://localhost:3000"

# Credenciais do único administrador do MVP. Nunca versione valores reais.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="substitua-por-uma-senha-forte"
JWT_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
